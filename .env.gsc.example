# Google Search Console service-account credentials for local runs.
# Do not commit the real .env.gsc file.
#
# Value is the full service-account JSON key as ONE LINE (the JSON itself is
# what goes in single quotes; its \n-escaped private_key already fits on one
# line, no reformatting needed). This is the exact same credential already
# stored as the GitHub Actions secret GSC_CREDENTIALS for the deploy workflow
# — reuse that value here rather than creating a second key if you have it
# saved somewhere (password manager, original download from Google Cloud).
GSC_CREDENTIALS='{"type":"service_account","project_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"...@....iam.gserviceaccount.com", ...}'
